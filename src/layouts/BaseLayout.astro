---
const { title = 'Business Builder', description = 'Find the business direction that fits your life and priorities.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title><style>:root{font-family:system-ui,sans-serif;color:#191919;background:#faf8f5}*{box-sizing:border-box}body{margin:0}main{max-width:1050px;margin:auto;padding:2rem 1.25rem}nav{display:flex;gap:1rem;align-items:center;padding:1rem 1.25rem;border-bottom:1px solid #ddd;background:white}nav a{color:inherit;text-decoration:none}.brand{font-weight:700;margin-right:auto}.card{background:white;border:1px solid #ddd;border-radius:16px;padding:1.25rem;margin:1rem 0}.button{display:inline-block;padding:.75rem 1rem;border-radius:10px;background:#191919;color:white;text-decoration:none}h1{font-size:clamp(2rem,6vw,4rem);line-height:1.05;max-width:15ch}p{line-height:1.65}.muted{color:#666}</style></head><body><nav><a class="brand" href="/">Business Builder</a><a href="/quiz">Quiz</a><a href="/library">Library</a><a href="/account">Account</a></nav><main><slot/></main></body></html>