---
import '../styles/site.css';
---
<head><meta charset="utf-8"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head>
<header class="site-header"><a class="brand" href="/">Call Me Allie <em>Business</em></a><nav aria-label="Main navigation"><a href="/quiz">Business Direction Quiz</a><a href="/library">Library</a><a href="/account">Account</a></nav></header>
<main class="account-page">
 <section id="account-loading" class="card" role="status"><h1>Your account</h1><p>Checking your account…</p></section>
 <section id="account-guest" class="account-welcome" hidden>
  <p class="eyebrow">YOUR BUSINESS DIRECTION</p>
  <h1>Your business journey, saved in one place.</h1>
  <p>Your quiz and recommendations are free. Create a free account to save your results for later and access training you've purchased.</p>
  <div class="guide-links"><a class="button primary-cta" href="/register?next=%2Faccount">Create a Free Account</a><a class="button secondary" href="/login?next=%2Faccount">Sign In</a></div>
  <p class="muted">You don't need an account to take the quiz or see your results.</p><a href="/quiz">Take the free quiz →</a>
 </section>
 <section id="account-member" hidden>
  <h1 id="account-greeting">Your account</h1>
  <div id="account-warnings" aria-live="polite"></div>
  <div id="pending-save" class="card" hidden><h2>Save your quiz results</h2><p id="pending-save-status"></p><button type="button" id="retry-save" hidden>Try again</button></div>
  <section class="card"><h2>Your saved business directions</h2><div id="saved-directions"><p>No saved results yet.</p></div><a class="button secondary" href="/quiz">Take or Retake the Quiz</a></section>
  <section class="card"><h2>Business Builder Library</h2><div id="library-access"><p>The 46-guide Business Builder Library is a separate one-time purchase.</p></div><a class="button secondary" href="/library">Browse the Library</a></section>
  <section class="card" id="account-license-card" hidden><h2>Commercial licenses</h2><div id="account-licenses"></div></section>
  <form method="post" action="/api/auth/logout"><button type="submit" class="button secondary">Sign Out</button></form>
 </section>
</main>
<script>
const el=id=>document.getElementById(id);
function show(id){el('account-loading').hidden=true;el(id).hidden=false}
function para(target,text){const p=document.createElement('p');p.textContent=text;target.appendChild(p)}
function renderAccount(data){
 show('account-member');
 el('account-greeting').textContent='Welcome back, '+data.name+'.';
 for(const warning of data.warnings||[])para(el('account-warnings'),warning);
 if(data.isOwner){const a=document.createElement('a');a.href='/admin/settings';a.textContent='Manage site settings →';el('account-warnings').appendChild(a)}
 if(data.attempts?.length){
  const list=el('saved-directions');list.replaceChildren();
  for(const item of data.attempts){
   const block=document.createElement('div');block.className='card';
   const title=document.createElement('strong');title.textContent=item.business_shape||'Business direction';block.appendChild(title);
   if(item.implementation_direction)para(block,item.implementation_direction);
   const small=document.createElement('small');small.textContent=(item.completed_at||'')+(item.is_current?' · Current':'');block.appendChild(small);list.appendChild(block)
  }
 }
 if(data.entitlements?.length){const list=el('library-access');list.replaceChildren();for(const item of data.entitlements)para(list,(item.entitlement_key||'Library')+' · '+(item.status||'Unknown'))}
 if(data.licenses?.length){el('account-license-card').hidden=false;for(const item of data.licenses)para(el('account-licenses'),(item.name||'License')+' · '+(item.status||'Unknown'))}
}
async function savePending(){
 const pending=sessionStorage.getItem('allie_pending_quiz_result');
 if(!pending||el('account-member').hidden)return;
 el('pending-save').hidden=false;el('retry-save').hidden=true;el('pending-save-status').textContent='Saving your quiz results…';
 try{
  const r=await fetch('/api/quiz/save',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:pending});
  if(!r.ok)throw new Error('Save failed');
  sessionStorage.removeItem('allie_pending_quiz_result');
  el('pending-save-status').textContent='Results saved. Refresh this page to see them in your history.';
 }catch{
  el('pending-save-status').textContent='Could not save results yet. They are retained in this browser tab.';
  el('retry-save').hidden=false;
 }
}
el('retry-save').addEventListener('click',savePending);
(async()=>{
 try{
  const response=await fetch('/api/account/summary',{headers:{Accept:'application/json'},credentials:'same-origin',cache:'no-store'});
  if(response.status===401){show('account-guest');return}
  const data=await response.json();
  if(data.authenticated){renderAccount(data);await savePending()}
  else{show('account-guest');if(data.unavailable)para(el('account-guest'),data.message||'Account service is currently unavailable.')}
 }catch{
  show('account-guest');para(el('account-guest'),'Account details are temporarily unavailable. You can still take the quiz.');
 }
})();
</script>