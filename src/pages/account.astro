---
import '../styles/site.css';import{dbFrom}from'../lib/db.js';import{getCurrentUser}from'../lib/auth.js';
const db=dbFrom(Astro.locals),user=await getCurrentUser(db,Astro.request,Astro.locals);if(!user)return Astro.redirect('/login');let ents=[],attempts=[],licenses=[];if(db){ents=(await db.prepare(`SELECT entitlement_key,status,ends_at FROM entitlements WHERE user_id=? ORDER BY created_at DESC`).bind(user.id).all()).results||[];attempts=(await db.prepare(`SELECT qa.id,qa.completed_at,qa.is_current,qr.business_shape,qr.implementation_direction,qr.confidence FROM quiz_attempts qa LEFT JOIN quiz_results qr ON qr.attempt_id=qa.id WHERE qa.user_id=? ORDER BY qa.completed_at DESC LIMIT 20`).bind(user.id).all()).results||[];licenses=(await db.prepare(`SELECT l.status,l.billing_status,l.current_period_end,lt.name FROM licenses l JOIN license_types lt ON lt.id=l.license_type_id WHERE l.owner_user_id=? ORDER BY l.created_at DESC`).bind(user.id).all()).results||[]}
---
<head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /></head><header class="site-header"><a class="brand" href="/">Call Me Allie <em>Business</em></a><nav aria-label="Main navigation"><a href="/quiz">Business Direction Quiz</a><a href="/library">Library</a><a href="/account">Account</a></nav></header>
<main><a href="/">← Home</a><h1>{user.display_name||user.email}</h1><section class="card"><h2>Your access</h2>{ents.length? <ul>{ents.map(e=><li><strong>{e.entitlement_key}</strong> · {e.status}{e.ends_at?` through ${e.ends_at}`:''}</li>)}</ul>:<p>No paid capabilities yet. Your free account can still save quiz history.</p>}</section><section class="card"><h2>Commercial licenses</h2>{licenses.length?<ul>{licenses.map(l=><li><strong>{l.name}</strong> · {l.status}{l.billing_status?` · ${l.billing_status}`:''}{l.current_period_end?` · paid through ${l.current_period_end}`:''}</li>)}</ul>:<p>No commercial licenses yet.</p>}</section><section class="card"><h2>Quiz history</h2>{attempts.length?<div class="toc">{attempts.map(a=><div><strong>{a.business_shape||'Result'}</strong> · {a.confidence||''} {a.is_current?'· Current':''}<br/><span class="muted">{a.completed_at}</span></div>)}</div>:<p>No saved quiz attempts yet.</p>}<a class="button secondary" href="/quiz">Take the quiz</a></section><form method="post" action="/api/auth/logout"><button class="secondary">Sign out</button></form></main>