---
import '../../styles/site.css';import {dbFrom} from '../../lib/db.js';import {getCurrentUser} from '../../lib/auth.js';
const db=dbFrom(Astro.locals),user=await getCurrentUser(db,Astro.request,Astro.locals);
if(!user?.is_owner)return Astro.redirect('/login?next=/admin/affiliates');
const rows=await db.prepare(`SELECT a.id,a.public_code,a.status,a.stripe_charges_enabled,a.stripe_payouts_enabled,u.email FROM affiliates a JOIN users u ON u.id=a.user_id ORDER BY a.created_at DESC LIMIT 200`).all();
---
<main><a href="/admin">← Admin</a><h1>Affiliate approvals</h1><p>Only approve affiliates you have reviewed. Stripe onboarding is a separate requirement.</p>{(rows.results||[]).map(a=><section class="card"><p>{a.email} · {a.public_code} · {a.status}</p><p>Charges: {a.stripe_charges_enabled?'ready':'not ready'} · Payouts: {a.stripe_payouts_enabled?'ready':'not ready'}</p><form method="post" action="/api/admin/affiliates"><input type="hidden" name="affiliate_id" value={a.id}/><button name="status" value="active">Approve</button> <button name="status" value="suspended">Suspend</button></form></section>)}</main>
