---
import '../../styles/site.css';import{dbFrom}from'../../lib/db.js';import{getCurrentUser}from'../../lib/auth.js';
const db=dbFrom(Astro.locals),user=await getCurrentUser(db,Astro.request,Astro.locals);if(!user?.is_owner)return Astro.redirect('/login');const rows=(await db.prepare(`SELECT a.id,a.status,a.referral_code,u.email FROM affiliates a JOIN users u ON u.id=a.user_id ORDER BY a.created_at DESC LIMIT 100`).all()).results||[];
---
<main><a href="/admin">← Admin</a><h1>Affiliates</h1><section class="card">{rows.length?<table><thead><tr><th>Email</th><th>Code</th><th>Status</th><th>Action</th></tr></thead><tbody>{rows.map(r=><tr><td>{r.email}</td><td>{r.referral_code}</td><td>{r.status}</td><td><form method="post" action="/api/admin/affiliates"><input type="hidden" name="affiliate_id" value={r.id}/><input type="hidden" name="status" value={r.status==='active'?'suspended':'active'}/><button class="secondary">{r.status==='active'?'Suspend':'Activate'}</button></form></td></tr>)}</tbody></table>:<p>No affiliates yet.</p>}</section></main>