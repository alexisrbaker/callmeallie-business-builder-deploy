---
import '../../styles/site.css';import{dbFrom,getSetting}from'../../lib/db.js';import{getCurrentUser}from'../../lib/auth.js';const db=dbFrom(Astro.locals),u=await getCurrentUser(db,Astro.request,Astro.locals);if(!u?.is_owner)return Astro.redirect('/login');
const fee=Number(await getSetting(db,'content_mrr_monthly_fee_cents')||2500),price=await getSetting(db,'content_mrr_stripe_price_id')||'';
const terms=(await db.prepare(`SELECT lt.id,lt.version,lt.status,lt.effective_at FROM license_terms lt JOIN license_types t ON t.id=lt.license_type_id WHERE t.key='content_mrr' ORDER BY lt.effective_at DESC`).all()).results||[];
---
<main><a href="/admin">← Admin</a><h1>Licensing Authority</h1><section class="card"><h2>Content MRR billing</h2><p>Current configured display fee: ${(fee/100).toFixed(2)}/month.</p><p>Stripe recurring Price ID: {price||'Not configured'}</p><p>The Price ID controls what Stripe actually bills. Keep the display fee synchronized with that Stripe price.</p><form method="post" action="/api/admin/licensing"><label>Monthly fee in cents<input name="fee_cents" type="number" min="0" value={fee}/></label><label>Stripe recurring Price ID<input name="stripe_price_id" value={price} placeholder="price_..."/></label><button>Save billing settings</button></form></section><section class="card"><h2>Terms versions</h2>{terms.length?<ul>{terms.map(t=><li>{t.version} · {t.status} · {t.effective_at}</li>)}</ul>:<p>No terms versions exist.</p>}<p>Draft terms are intentionally not enough to open activation. Publishing reviewed terms needs its own explicit workflow.</p></section></main>
