---
import '../../styles/site.css';import{dbFrom,getSetting}from'../../lib/db.js';import{getCurrentUser}from'../../lib/auth.js';
const db=dbFrom(Astro.locals),user=await getCurrentUser(db,Astro.request,Astro.locals);if(!user?.is_owner)return Astro.redirect('/login');const fee=await getSetting(db,'content_mrr_monthly_fee_cents')||'2500',price=await getSetting(db,'content_mrr_stripe_price_id')||'';const rows=(await db.prepare(`SELECT l.id,l.status,l.billing_status,l.current_period_end,u.email FROM licenses l JOIN users u ON u.id=l.owner_user_id ORDER BY l.created_at DESC LIMIT 100`).all()).results||[];
---
<main><a href="/admin">← Admin</a><h1>Licensing</h1><section class="card"><h2>Content MRR billing</h2><form method="post" action="/api/admin/licensing"><label>Monthly fee in cents<input name="fee_cents" value={fee}/></label><label>Stripe recurring price ID<input name="stripe_price_id" value={price}/></label><button>Save</button></form></section><section class="card"><h2>Recent licenses</h2>{rows.length?<table><thead><tr><th>Email</th><th>Status</th><th>Billing</th><th>Period end</th></tr></thead><tbody>{rows.map(r=><tr><td>{r.email}</td><td>{r.status}</td><td>{r.billing_status||''}</td><td>{r.current_period_end||''}</td></tr>)}</tbody></table>:<p>No licenses yet.</p>}</section></main>