---
import '../../styles/site.css';import{dbFrom,getSetting}from'../../lib/db.js';import{getCurrentUser}from'../../lib/auth.js';const db=dbFrom(Astro.locals),u=await getCurrentUser(db,Astro.request,Astro.locals);if(!u?.is_owner)return Astro.redirect('/login');const keys=['business_name','site_title','contact_email','primary_color','logo_url'];const s={};for(const k of keys)s[k]=await getSetting(db,k)||'';
---
<main><a href="/admin">← Admin</a><h1>Site settings</h1>{Astro.url.searchParams.get('saved')&&<p class="ok">✓ Settings saved</p>}<form class="card" method="post" action="/api/admin/settings"><label>Business name<input name="business_name" value={s.business_name}></label><label>Site title<input name="site_title" value={s.site_title}></label><label>Contact email<input type="email" name="contact_email" value={s.contact_email}></label><label>Primary brand color<input name="primary_color" value={s.primary_color} placeholder="#000000"></label><label>Logo URL<input name="logo_url" value={s.logo_url}></label><button>Save settings</button></form><section class="card"><h2>Homepage hero image</h2><p>Upload the image displayed alongside the homepage quiz invitation. This setting belongs to this website, so each customer can choose their own image.</p><img src="/media/hero" alt="Current homepage hero" style="width:100%;max-width:540px;border-radius:18px" onerror="this.style.display='none'"/><form method="post" action="/api/admin/hero-image" enctype="multipart/form-data"><label for="hero_image">Choose hero image (JPG, PNG, WebP, AVIF; up to 8 MB)</label><input id="hero_image" type="file" name="hero_image" accept="image/jpeg,image/png,image/webp,image/avif" required /><button type="submit">Save hero image</button></form>{Astro.url.searchParams.get('hero_saved')&&<p class="ok">Hero image updated.</p>}</section><section class="card"><h2>Connections</h2><p class="warn">○ Stripe connection: guided connection flow is next.</p><p class="warn">○ Transactional email: guided connection flow is next.</p><p class="warn">○ Allie licensing: only required when protected licensed materials are enabled.</p></section></main>