---
import { dbFrom } from '../../lib/db.js';
import { getCurrentUser } from '../../lib/auth.js';
import { findUserByReferralCode, hasPaidMrrPackage } from '../../lib/mrr.js';
const db=dbFrom(Astro.locals); const user=await getCurrentUser(db,Astro.request,Astro.locals);
const ref=Astro.url.searchParams.get('ref')||''; const aff=Astro.url.searchParams.get('aff')||''; const seller=await findUserByReferralCode(db,ref);
const owns=user?await hasPaidMrrPackage(db,user.id):false;
---
<html><head><title>Business Builder MRR</title><link rel="stylesheet" href="/styles/site.css" /></head><body><main><a href="/">← Home</a><h1>Business Builder Master Resell Rights</h1><p>Build your own business around the licensed Business Builder PDF package. The initial package purchase and the continuing commercial license are intentionally separate.</p><section class="card"><h2>$460 initial package</h2><p>Your purchase includes the current designated MRR package and personal access to the hosted Business Builder Library.</p><p>Buying the package does <strong>not</strong> by itself activate commercial resale rights. Before making new licensed sales, you must register and maintain the separate active commercial license with Allie and accept the current license terms.</p>{seller&&<p>This purchase was referred by {seller.display_name||'a Business Builder reseller'}.</p>}{owns?<p class="ok">✓ You already own the MRR package.</p>:user?<form method="post" action="/api/checkout/mrr"><input type="hidden" name="ref" value={ref}/><input type="hidden" name="aff" value={aff}/><button>Buy MRR package for $460</button></form>:<p><a href={`/login?next=${encodeURIComponent('/mrr'+(ref?`?ref=${ref}`:(aff?`?aff=${aff}`:'')))}`}>Log in</a> or <a href="/register">create an account</a> to purchase.</p>}</section><section class="card"><h2>Then activate commercial rights</h2><p>After the package purchase, activation is handled directly through Allie's licensing authority. The active license is the separate ongoing relationship that keeps new commercial resale rights active and provides eligible updates and training.</p><p><strong>The current license fee and legal terms shown during activation control.</strong> The package price does not lock a future license fee or replace the license agreement.</p>{owns&&<a class="button" href="/mrr/activate">Continue to license activation →</a>}</section></main></body></html>
