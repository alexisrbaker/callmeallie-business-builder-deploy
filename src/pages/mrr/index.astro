import { findUserByReferralCode, hasPaidMrrPackage } from '../../lib/mrr.js';
const db=dbFrom(Astro.locals); let user=null;try{if(db)user=await getCurrentUser(db,Astro.request,Astro.locals)}catch(e){console.error('MRR auth check',e)}
const ref=Astro.url.searchParams.get('ref')||''; const aff=Astro.url.searchParams.get('aff')||''; let seller=null;try{seller=await findUserByReferralCode(db,ref)}catch(e){console.error('MRR referral check',e)}
let owns=false;try{if(user)owns=await hasPaidMrrPackage(db,user.id)}catch(e){console.error('MRR ownership check',e)}
