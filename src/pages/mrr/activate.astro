---
import { dbFrom } from '../../lib/db.js';
import { getCurrentUser } from '../../lib/auth.js';
import { hasPaidMrrPackage } from '../../lib/mrr.js';
const db=dbFrom(Astro.locals);const user=await getCurrentUser(db,Astro.request,Astro.locals);if(!user)return Astro.redirect('/login?next=/mrr/activate');const owns=await hasPaidMrrPackage(db,user.id);
let terms=null;try{terms=await db.prepare(`SELECT lt.id,lt.version,lt.terms_content FROM license_terms lt JOIN license_types t ON t.id=lt.license_type_id WHERE t.key='content_mrr' AND lt.status='active' AND lt.effective_at<=CURRENT_TIMESTAMP ORDER BY lt.effective_at DESC LIMIT 1`).first();}catch{}
---
<html><head><title>Activate MRR License</title><link rel="stylesheet" href="/styles/site.css" /></head><body><main><a href="/mrr">← MRR</a><h1>Activate your commercial license</h1>{!owns?<section class="card"><p>You need the Business Builder MRR package before activating its commercial resale license.</p><a href="/mrr">View MRR package →</a></section>:!terms?<section class="card"><h2>Activation is not open yet</h2><p>The official commercial license terms have not been published. A package purchase does not silently accept draft terms and does not create commercial resale rights.</p></section>:<section class="card"><h2>Current terms: {terms.version}</h2><div style="white-space:pre-wrap">{terms.terms_content}</div><p>The current recurring fee and billing terms will be shown before you authorize payment.</p><form method="post" action="/api/licensing/start-activation"><label><input type="checkbox" name="accept" value="yes" required/> I have read and accept these license terms.</label><input type="hidden" name="terms_id" value={terms.id}/><button>Continue to license billing</button></form></section>}</main></body></html>
