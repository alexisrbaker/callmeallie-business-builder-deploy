---
import '../../styles/site.css';import{dbFrom}from'../../lib/db.js';import{getCurrentUser}from'../../lib/auth.js';
const db=dbFrom(Astro.locals),user=await getCurrentUser(db,Astro.request,Astro.locals);if(!user)return Astro.redirect('/login?next=/mrr/activation-success');
const license=await db.prepare(`SELECT l.status,l.billing_status,l.current_period_end,lt.name FROM licenses l JOIN license_types lt ON lt.id=l.license_type_id WHERE l.owner_user_id=? AND lt.key='content_mrr' ORDER BY l.created_at DESC LIMIT 1`).bind(user.id).first();
---
<html><head><title>License activation</title><link rel="stylesheet" href="/styles/site.css" /></head><body><main><h1>{license?.status==='active'?'Commercial license active':'License activation processing'}</h1>{license?<section class="card"><p><strong>{license.name}</strong></p><p>Status: {license.status}</p><p>Billing: {license.billing_status||'processing'}</p>{license.current_period_end&&<p>Current paid period through: {license.current_period_end}</p>}<p>Your package purchase remains separate from this commercial license. If the license later becomes inactive, your personal purchased access remains while new licensed commercial use stops according to the license terms.</p></section>:<section class="card"><p>Stripe has returned you to the site, but the signed webhook may still be arriving. Refresh shortly. The browser redirect alone does not activate commercial rights.</p></section>}<p><a href="/account">Open my account →</a></p></main></body></html>
