---
import '../styles/site.css';
import guides from '../data/guides.json';
let result=null;
try{result=JSON.parse(decodeURIComponent(Astro.url.searchParams.get('r')||''));}catch{}
const byNum=new Map(guides.map(g=>[g.number,g]));
---
<head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /></head><header class="site-header"><a class="brand" href="/">Call Me Allie <em>Business</em></a><nav aria-label="Main navigation"><a href="/quiz">Business Direction Quiz</a><a href="/library">Library</a><a href="/account">Account</a></nav></header>
<main><a href="/quiz">← Retake quiz</a><h1>Your starting direction</h1>{!result?<section class="card"><p>Your result is not available. Retake the questionnaire to create one.</p></section>:<><section class="card"><p class="eyebrow">{result.confidence} confidence</p><h2>{result.shape}</h2><p><strong>{result.implementation}</strong></p>{result.secondary?.length>0&&<p>Other directions still worth comparing: {result.secondary.join(', ')}.</p>}</section>{result.reasons?.length>0&&<section class="card"><h2>Why this direction surfaced</h2><ul>{result.reasons.map(x=><li>{x}</li>)}</ul></section>}{result.tradeoffs?.length>0&&<section class="card"><h2>Tradeoffs to keep in view</h2><ul>{result.tradeoffs.map(x=><li>{x}</li>)}</ul></section>}{result.unresolved?.length>0&&<section class="card"><h2>Questions you still need to answer</h2><ul>{result.unresolved.map(x=><li>{x}</li>)}</ul></section>}{result.fallbackText&&<section class="card"><h2>Where to explore when the signal is mixed</h2><p>{result.fallbackText}</p></section>}<section class="card"><h2>Keep your direction for later</h2><p>Your recommendations are free. Create an account or sign in only if you'd like to save them and find them again.</p><button id="save-results" type="button">Save My Results</button><p id="save-message" aria-live="polite"></p></section><section class="card"><h2>Explore the recommended guides</h2><p class="muted">The Business Builder training guides are paid content.</p><div class="guide-links">{[...(result.recommendedGuides||[]),...(result.fallback||[])].map(n=>{const g=byNum.get(n);return g&&<a class="button secondary" href={`/library/${g.slug}`}>Guide {g.number}: {g.title}</a>})}</div></section><p class="muted">This result is a starting point, not a promise that a business will make money. Specific costs, demand, program terms, legal requirements and other consequential facts still need independent verification.</p></>}</main>

<script>
const save=document.querySelector('#save-results');
if(save){save.addEventListener('click',async()=>{
 const params=new URL(location.href).searchParams;let result;
 try{result=JSON.parse(decodeURIComponent(params.get('r')||''))}catch{}
 if(!result){document.querySelector('#save-message').textContent='Your result could not be read. Please retake the quiz.';return}
 sessionStorage.setItem('allie_pending_quiz_result',JSON.stringify(result));
 save.disabled=true;try{
 const response=await fetch('/api/quiz/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(result)});
 if(response.ok){sessionStorage.removeItem('allie_pending_quiz_result');document.querySelector('#save-message').textContent='Saved to your account.';return}
 if(response.status===401){location.href='/register?next='+encodeURIComponent('/account?save_quiz=1');return}
 document.querySelector('#save-message').textContent='Your result was not saved. Try again after signing in.';
 }catch{document.querySelector('#save-message').textContent='Unable to save yet. Please try again.'}finally{save.disabled=false}
 })}
</script>
