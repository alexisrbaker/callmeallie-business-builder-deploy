---
import '../styles/site.css';
import guides from '../data/guides.json';
let result=null;
try{result=JSON.parse(decodeURIComponent(Astro.url.searchParams.get('r')||''));}catch{}
const byNum=new Map(guides.map(g=>[g.number,g]));
---
<head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /></head><header class="site-header"><a class="brand" href="/">Call Me Allie <em>Business</em></a><nav aria-label="Main navigation"><a href="/quiz">Business Direction Quiz</a><a href="/library">Library</a><a href="/account">Account</a></nav></header>
<main><a href="/quiz">← Retake quiz</a><h1>Your starting direction</h1>{!result?<section class="card"><p>Your result is not available. Retake the questionnaire to create one.</p></section>:<><section class="card"><p class="eyebrow">{result.confidence} confidence</p><h2>{result.shape}</h2><p><strong>{result.implementation}</strong></p>{result.secondary?.length>0&&<p>Other directions still worth comparing: {result.secondary.join(', ')}.</p>}</section>{result.reasons?.length>0&&<section class="card"><h2>Why this direction surfaced</h2><ul>{result.reasons.map(x=><li>{x}</li>)}</ul></section>}{result.tradeoffs?.length>0&&<section class="card"><h2>Tradeoffs to keep in view</h2><ul>{result.tradeoffs.map(x=><li>{x}</li>)}</ul></section>}{result.unresolved?.length>0&&<section class="card"><h2>Questions you still need to answer</h2><ul>{result.unresolved.map(x=><li>{x}</li>)}</ul></section>}{result.fallbackText&&<section class="card"><h2>Where to explore when the signal is mixed</h2><p>{result.fallbackText}</p></section>}<section class="card"><h2>Open these guides</h2><div class="guide-links">{[...(result.recommendedGuides||[]),...(result.fallback||[])].map(n=>{const g=byNum.get(n);return g&&<a class="button secondary" href={`/library/${g.slug}`}>Guide {g.number}: {g.title}</a>})}</div></section><p class="muted">This result is a starting point, not a promise that a business will make money. Specific costs, demand, program terms, legal requirements and other consequential facts still need independent verification.</p></>}</main>
