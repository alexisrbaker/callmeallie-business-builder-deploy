---
import '../styles/site.css';
import questionnaire from '../data/questionnaire.json';
---
<head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /></head>
<header class="site-header"><a class="brand" href="/">Call Me Allie <em>Business</em></a><nav aria-label="Main navigation"><a href="/quiz">Business Direction Quiz</a><a href="/library">Library</a><a href="/account">Account</a></nav></header><main class="quiz-page"><h1>Business Direction Quiz</h1><p>This is a fast navigator, not a permanent business-type label. Answer for the life, money, time and priorities you have right now.</p><div class="quiz-progress"><div id="quiz-progress-fill"></div></div><p id="quiz-step-counter" class="muted" aria-live="polite"></p><form id="quiz" method="post" action="/api/quiz"><input type="hidden" name="questionnaire_version" value={questionnaire.version} />{questionnaire.questions.map((q)=><fieldset class="card"><legend>{q.position}. {q.text}</legend>{q.options.map((o)=><label class="option"><input type="radio" name={q.id} value={o.id} required/><span>{o.text}</span></label>)}</fieldset>)}<fieldset class="card priority-card" hidden id="priority"><legend>{questionnaire.priorityTieBreaker.position}. {questionnaire.priorityTieBreaker.text}</legend><p class="muted">{questionnaire.priorityTieBreaker.help}</p><div id="priority-options"></div></fieldset><div class="quiz-controls"><button type="button" id="quiz-back" class="button secondary">← Back</button><button id="quiz-submit" type="submit">See My Results →</button></div></form></main>
<script>
const labels={speed:'Get to something sellable and a realistic chance of first revenue sooner',low_risk:'Keep the amount of money I risk before proof as low as possible',ownership:'Own and control the product or offer, even if it takes longer',leverage:'Keep each additional sale from requiring much more of my time',repeat:'Build repeat or recurring customer revenue into the model',people:'Work directly with customers and help them get a result',physical:'Work with a physical product rather than a purely digital offer',digital:'Keep the business primarily digital and avoid physical operations'};
function values(form){return Object.fromEntries(new FormData(form).entries())}
function candidates(a){const out=[];const add=k=>{if(!out.includes(k))out.push(k)};if(['A','B'].includes(a.q1)||a.q15==='B')add('speed');if(['A','B'].includes(a.q2)||a.q15==='A')add('low_risk');if(['B','C','D'].includes(a.q6)||['A','C'].includes(a.q9)||a.q15==='C')add('ownership');if(['A','B'].includes(a.q5)||a.q15==='D')add('leverage');if(['A','B'].includes(a.q10)||['A','B','C'].includes(a.q11))add('repeat');if(['C','D'].includes(a.q4)||a.q13==='C')add('people');if(a.q7==='B')add('physical');if(a.q7==='A')add('digital');for(const k of ['speed','low_risk','ownership','leverage'])if(out.length<4)add(k);return out.slice(0,4)}
const form=document.querySelector('#quiz'), box=document.querySelector('#priority'), opts=document.querySelector('#priority-options');
function render(){const a=values(form);const complete=[...Array(15)].every((_,i)=>a[`q${i+1}`]);if(!complete){box.hidden=true;opts.innerHTML='';return}const selected=a.q16;opts.innerHTML=candidates(a).map(k=>`<label class="option"><input type="radio" name="q16" value="${k}" required ${selected===k?'checked':''}><span>${labels[k]}</span></label>`).join('');box.hidden=false}
const fields=Array.from(form.querySelectorAll('fieldset.card'));const progress=document.querySelector('#quiz-progress-fill');const counter=document.querySelector('#quiz-step-counter');const back=document.querySelector('#quiz-back');const submit=document.querySelector('#quiz-submit');let current=0;let timeout;
function show(index){clearTimeout(timeout);current=Math.min(fields.length-1,Math.max(0,index));fields.forEach((f,i)=>{f.hidden=i!==current});counter.textContent='Question '+(current+1)+' of '+fields.length;progress.style.width=((current+1)/fields.length*100)+'%';back.hidden=current===0;submit.hidden=current!==fields.length-1;}
form.addEventListener('change',e=>{render();const field=e.target.closest('fieldset');if(field!==fields[current])return;if(current<fields.length-1){clearTimeout(timeout);timeout=setTimeout(()=>show(current+1),450)}});
back.addEventListener('click',()=>show(current-1));
form.addEventListener('submit',e=>{let i=fields.findIndex(f=>!f.querySelector('input[type="radio"]:checked'));if(i>=0){e.preventDefault();show(i)}});
render();show(0);
</script>