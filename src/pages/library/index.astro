---
import '../../styles/site.css';
import guides from '../../data/guides.json';
const branches=['Start','One-Off','Consumable','Subscription','Service','Finish'];
---
<head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /></head>
<header class="site-header"><a class="brand" href="/">Call Me Allie <em>Business</em></a><nav aria-label="Main navigation"><a href="/quiz">Business Direction Quiz</a><a href="/library">Library</a><a href="/account">Account</a></nav></header><main><h1>Business Builder Library</h1><p>There are 46 guides here, but you are not expected to read all 46. Start with the quiz or Guide 1, then follow the decisions that apply to you.</p><div class="guide-links"><a class="button" href="/quiz">Find my starting point</a><a class="button secondary" href={`/library/${guides[0].slug}`}>Start with Guide 1</a></div>{branches.map(b=><section class="card"><h2>{b}</h2><div class="toc">{guides.filter(g=>g.branch===b).map(g=><a href={`/library/${g.slug}`}><span>{String(g.number).padStart(2,'0')}</span>{g.title}</a>)}</div></section>)}</main>
